async function spriteToCHR(src) {
  return new Promise((resolve) => {
    if (!src || src.length < 50) {
      resolve(new Uint8Array(16));
      return;
    }
    const img = new Image();
    img.onload = () => {
      const c = document.createElement("canvas");
      c.width = 8;
      c.height = 8;
      const ctx = c.getContext("2d");
      ctx.imageSmoothingEnabled = false;
      const fw = img.width > img.height ? img.height : img.width;
      ctx.drawImage(img, 0, 0, fw, img.height, 0, 0, 8, 8);
      const d = ctx.getImageData(0, 0, 8, 8).data;
      const p0 = new Uint8Array(8), p1 = new Uint8Array(8);
      for (let y2 = 0; y2 < 8; y2++) for (let x = 0; x < 8; x++) {
        const i = (y2 * 8 + x) * 4;
        if (d[i + 3] < 64) continue;
        const br = (d[i] + d[i + 1] + d[i + 2]) / 3;
        const cv = br < 64 ? 1 : br < 160 ? 2 : 3;
        if (cv & 1) p0[y2] |= 1 << 7 - x;
        if (cv & 2) p1[y2] |= 1 << 7 - x;
      }
      const t2 = new Uint8Array(16);
      t2.set(p0, 0);
      t2.set(p1, 8);
      resolve(t2);
    };
    img.onerror = () => resolve(new Uint8Array(16));
    img.src = src;
  });
}
