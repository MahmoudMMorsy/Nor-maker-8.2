                g.gain.exponentialRampToValueAtTime(0.001, now + (dur||0.1));
                o.connect(g); g.connect(GM82Audio.ctx.destination);
                o.start(now); o.stop(now + (dur||0.1));
            } catch(e) {
                console.warn("NOR ENGINE: _beep failed:", e);
            }
